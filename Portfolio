    <!-- ENGINE CANVAS CODE + SCROLL ENGINE -->
    <script>
        /* ========================================================
           MOTEUR DE CURSEURS PERSONNALISÉS
           ======================================================== */
        const cursorMatrix   = document.getElementById('cursor-matrix');
        const cursorSW       = document.getElementById('cursor-starwars');
        const saberCanvas    = document.getElementById('saber-trail-canvas');
        const saberCtx       = saberCanvas.getContext('2d');
        const cbTheme        = document.getElementById('theme-switch');

        let mouseX = -200, mouseY = -200;
        let trailPoints = []; // pour le trail sabre

        // Resize du canvas trail
        function resizeSaber() {
            saberCanvas.width  = window.innerWidth;
            saberCanvas.height = window.innerHeight;
            saberCanvas.style.width  = window.innerWidth  + 'px';
            saberCanvas.style.height = window.innerHeight + 'px';
        }
        resizeSaber();
        window.addEventListener('resize', resizeSaber);

        // Suivi de la souris
        document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            // Déplace curseur Matrix
            cursorMatrix.style.transform = `translate(${mouseX}px, ${mouseY}px)`;

            // Déplace curseur SW
            cursorSW.style.transform = `translate(${mouseX}px, ${mouseY}px)`;

            // Ajoute un point au trail
            trailPoints.push({ x: mouseX, y: mouseY, age: 0 });
            if (trailPoints.length > 28) trailPoints.shift();
        });

        // Hover sur éléments interactifs
        const interactives = 'a, button, label, input, textarea, .btn, .card, .project-card, .theme-btn';
        document.addEventListener('mouseover', (e) => {
            if (e.target.closest(interactives)) document.body.classList.add('cursor-hovering');
        });
        document.addEventListener('mouseout', (e) => {
            if (e.target.closest(interactives)) document.body.classList.remove('cursor-hovering');
        });

        // Sync classe thème sur body
        function syncThemeClass() {
            if (cbTheme.checked) {
                document.body.classList.add('theme-sw');
            } else {
                document.body.classList.remove('theme-sw');
            }
        }
        cbTheme.addEventListener('change', syncThemeClass);
        syncThemeClass();

        // Boucle trail sabre laser (Star Wars)
        function drawSaberTrail() {
            saberCtx.clearRect(0, 0, saberCanvas.width, saberCanvas.height);

            if (cbTheme.checked && trailPoints.length > 2) {
                for (let i = 1; i < trailPoints.length; i++) {
                    const p1 = trailPoints[i - 1];
                    const p2 = trailPoints[i];
                    const ratio   = i / trailPoints.length;
                    const alpha   = ratio * 0.75;
                    const width   = ratio * 3.5;

                    // Lueur bleue extérieure
                    saberCtx.beginPath();
                    saberCtx.strokeStyle = `rgba(79,172,254,${alpha * 0.5})`;
                    saberCtx.lineWidth   = width + 4;
                    saberCtx.lineCap     = 'round';
                    saberCtx.moveTo(p1.x, p1.y);
                    saberCtx.lineTo(p2.x, p2.y);
                    saberCtx.stroke();

                    // Cœur blanc/jaune
                    saberCtx.beginPath();
                    saberCtx.strokeStyle = `rgba(255,232,31,${alpha})`;
                    saberCtx.lineWidth   = width * 0.5;
                    saberCtx.lineCap     = 'round';
                    saberCtx.moveTo(p1.x, p1.y);
                    saberCtx.lineTo(p2.x, p2.y);
                    saberCtx.stroke();
                }
            }

            // Trail Matrix : petits caractères qui s'effacent
            if (!cbTheme.checked && trailPoints.length > 1) {
                for (let i = 0; i < trailPoints.length; i++) {
                    const ratio = i / trailPoints.length;
                    const alpha = ratio * 0.6;
                    const size  = 9 + ratio * 3;
                    saberCtx.font      = `${size}px 'Share Tech Mono', monospace`;
                    saberCtx.fillStyle = `rgba(0,255,102,${alpha})`;
                    const ch = Math.random() > 0.5 ? '1' : '0';
                    saberCtx.fillText(ch, trailPoints[i].x + 4, trailPoints[i].y - 4);
                }
            }

            requestAnimationFrame(drawSaberTrail);
        }
        drawSaberTrail();
        /* ========================================================
           MOTEUR DE TRANSITION THÉMATIQUE
           ======================================================== */
        const overlay    = document.getElementById('transition-overlay');
        const tCanvas    = document.getElementById('transition-canvas');
        const tCtx       = tCanvas.getContext('2d');
        const flashEl    = document.getElementById('transition-flash');

        function resizeTransition() {
            tCanvas.width  = window.innerWidth;
            tCanvas.height = window.innerHeight;
        }
        resizeTransition();
        window.addEventListener('resize', resizeTransition);

        /* ---------- TRANSITION MATRIX → STAR WARS ----------
           1. Glitch vert en cascade (colonnes qui se fragmentent)
           2. Flash blanc aveuglant
           3. Bascule du thème + fondu out
        -------------------------------------------------------- */
        function runMatrixToSW(onSwitch) {
            overlay.style.display = 'block';
            flashEl.style.background = '#ffffff';
            flashEl.style.opacity = '0';

            const W = tCanvas.width, H = tCanvas.height;
            const colW   = 18;
            const cols   = Math.ceil(W / colW);
            const chars  = "01";
            let frame    = 0;
            const totalFrames = 55;

            // colonnes avec délai décalé
            const colDelays = Array.from({length: cols}, (_, i) => Math.floor(Math.random() * 20));

            function drawGlitch() {
                // fond semi-transparent vert très sombre
                tCtx.fillStyle = frame < 10 ? 'rgba(2,5,10,0.0)' : 'rgba(2,5,10,0.18)';
                tCtx.fillRect(0, 0, W, H);

                for (let c = 0; c < cols; c++) {
                    if (frame < colDelays[c]) continue;
                    const progress = Math.min((frame - colDelays[c]) / 30, 1);
                    const numChars = Math.floor(progress * (H / colW) * 1.5);

                    for (let r = 0; r < numChars; r++) {
                        const ch = chars[Math.floor(Math.random() * chars.length)];
                        const alpha = Math.random() * 0.9 + 0.1;
                        const bright = Math.random() > 0.85;
                        tCtx.fillStyle = bright
                            ? `rgba(200,255,200,${alpha})`
                            : `rgba(0,255,102,${alpha * progress})`;
                        tCtx.font = `bold ${colW}px 'Share Tech Mono', monospace`;
                        tCtx.fillText(ch, c * colW, r * colW + colW);
                    }

                    // ligne de tête lumineuse
                    if (progress < 1) {
                        tCtx.fillStyle = '#ffffff';
                        tCtx.fillRect(c * colW, Math.floor(progress * H * 1.5 * colW / colW) * colW, colW, 2);
                    }
                }

                frame++;

                if (frame < totalFrames) {
                    requestAnimationFrame(drawGlitch);
                } else {
                    // Flash blanc
                    flashEl.style.transition = 'opacity 0.18s ease-in';
                    flashEl.style.opacity = '1';
                    setTimeout(() => {
                        onSwitch();
                        tCtx.clearRect(0, 0, W, H);
                        flashEl.style.transition = 'opacity 0.4s ease-out';
                        flashEl.style.opacity = '0';
                        setTimeout(() => { overlay.style.display = 'none'; }, 450);
                    }, 200);
                }
            }
            drawGlitch();
        }

        /* ---------- TRANSITION STAR WARS → MATRIX ----------
           1. Hyperespace : lignes de vitesse dorées qui s'allongent vers l'extérieur
           2. Flash jaune/blanc aveuglant
           3. Bascule du thème + fondu out
        ----------------------------------------------------- */
        function runSWToMatrix(onSwitch) {
            overlay.style.display = 'block';
            flashEl.style.background = '#ffe81f';
            flashEl.style.opacity = '0';

            const W = tCanvas.width, H = tCanvas.height;
            const cx = W / 2, cy = H / 2;
            const numStreaks = 220;
            let frame = 0;
            const totalFrames = 60;

            // Génère les étoiles filantes
            const streaks = Array.from({length: numStreaks}, () => {
                const angle = Math.random() * Math.PI * 2;
                const dist  = Math.random() * 120 + 30;
                return { angle, dist, speed: Math.random() * 0.065 + 0.04, length: Math.random() * 80 + 40 };
            });

            function drawHyperspace() {
                const progress = frame / totalFrames;
                // Fond qui s'assombrit
                tCtx.fillStyle = `rgba(2,5,10,${0.08 + progress * 0.18})`;
                tCtx.fillRect(0, 0, W, H);

                for (const s of streaks) {
                    const stretchFactor = 1 + progress * 12;
                    const curDist   = s.dist + frame * frame * s.speed * 1.8;
                    const tailDist  = Math.max(0, curDist - s.length * stretchFactor);

                    const x1 = cx + Math.cos(s.angle) * tailDist;
                    const y1 = cy + Math.sin(s.angle) * tailDist;
                    const x2 = cx + Math.cos(s.angle) * curDist;
                    const y2 = cy + Math.sin(s.angle) * curDist;

                    const alpha = Math.min(1, progress * 2.5);
                    const grad = tCtx.createLinearGradient(x1, y1, x2, y2);
                    grad.addColorStop(0, `rgba(255,232,31,0)`);
                    grad.addColorStop(0.4, `rgba(79,172,254,${alpha * 0.7})`);
                    grad.addColorStop(1, `rgba(255,255,255,${alpha})`);

                    tCtx.beginPath();
                    tCtx.strokeStyle = grad;
                    tCtx.lineWidth = 1 + progress * 2;
                    tCtx.moveTo(x1, y1);
                    tCtx.lineTo(x2, y2);
                    tCtx.stroke();
                }

                // Halo central qui grandit
                const haloR = progress * 200;
                if (haloR > 0) {
                    const halo = tCtx.createRadialGradient(cx, cy, 0, cx, cy, haloR);
                    halo.addColorStop(0, `rgba(255,232,31,${progress * 0.6})`);
                    halo.addColorStop(1, 'rgba(255,232,31,0)');
                    tCtx.fillStyle = halo;
                    tCtx.beginPath();
                    tCtx.arc(cx, cy, haloR, 0, Math.PI * 2);
                    tCtx.fill();
                }

                frame++;

                if (frame < totalFrames) {
                    requestAnimationFrame(drawHyperspace);
                } else {
                    flashEl.style.transition = 'opacity 0.15s ease-in';
                    flashEl.style.opacity = '1';
                    setTimeout(() => {
                        onSwitch();
                        tCtx.clearRect(0, 0, W, H);
                        flashEl.style.transition = 'opacity 0.5s ease-out';
                        flashEl.style.opacity = '0';
                        setTimeout(() => { overlay.style.display = 'none'; }, 550);
                    }, 180);
                }
            }
            drawHyperspace();
        }

        /* ---------- INTERCEPTION DU SWITCH ---------- */
        const themeLabel = document.querySelector('label[for="theme-switch"]');
        if (themeLabel) {
            themeLabel.addEventListener('click', (e) => {
                e.preventDefault();
                const cb = document.getElementById('theme-switch');
                const goingToSW = !cb.checked; // va passer à SW

                if (goingToSW) {
                    runMatrixToSW(() => { cb.checked = true; cb.dispatchEvent(new Event('change')); });
                } else {
                    runSWToMatrix(() => { cb.checked = false; cb.dispatchEvent(new Event('change')); });
                }
            });
        }
        const mCanvas = document.getElementById('matrix-canvas');
        const swCanvas = document.getElementById('starwars-canvas');
        const mCtx = mCanvas.getContext('2d');
        const swCtx = swCanvas.getContext('2d');
        const themeCheckbox = document.getElementById('theme-switch');

        // --- CANVAS RESIZE (recalcule les colonnes Matrix) ---
        const matrixChars = "0101010110010101110011010101011010110110";
        const charArray = matrixChars.split("");
        const fontSize = 14;
        let columns, rainDrops;

        function initMatrix() {
            columns = Math.floor(mCanvas.width / fontSize);
            rainDrops = Array(columns).fill(0).map(() => Math.random() * -50);
        }

        function resize() {
            mCanvas.width = swCanvas.width = window.innerWidth;
            mCanvas.height = swCanvas.height = window.innerHeight;
            initMatrix();
        }
        resize();
        window.addEventListener('resize', resize);

        // --- MATRIX RAIN ---
        function drawMatrix() {
            mCtx.fillStyle = 'rgba(2, 5, 10, 0.1)';
            mCtx.fillRect(0, 0, mCanvas.width, mCanvas.height);
            mCtx.fillStyle = '#00ff66';
            mCtx.font = fontSize + 'px monospace';

            for (let i = 0; i < rainDrops.length; i++) {
                const text = charArray[Math.floor(Math.random() * charArray.length)];
                mCtx.fillText(text, i * fontSize, rainDrops[i] * fontSize);
                if (rainDrops[i] * fontSize > mCanvas.height && Math.random() > 0.975) {
                    rainDrops[i] = 0;
                }
                rainDrops[i]++;
            }
        }

        // --- STARFIELD ---
        const numStars = 400;
        const stars = [];
        for (let i = 0; i < numStars; i++) {
            stars.push({
                x: Math.random() * swCanvas.width - swCanvas.width / 2,
                y: Math.random() * swCanvas.height - swCanvas.height / 2,
                z: Math.random() * swCanvas.width
            });
        }

        function drawStarWars() {
            swCtx.fillStyle = 'rgba(2, 5, 10, 0.15)';
            swCtx.fillRect(0, 0, swCanvas.width, swCanvas.height);
            const cx = swCanvas.width / 2;
            const cy = swCanvas.height / 2;

            for (let i = 0; i < numStars; i++) {
                let star = stars[i];
                let px = (star.x / star.z) * cx + cx;
                let py = (star.y / star.z) * cy + cy;

                star.z -= 10;
                if (star.z <= 0) {
                    star.z = swCanvas.width;
                    star.x = Math.random() * swCanvas.width - cx;
                    star.y = Math.random() * swCanvas.height - cy;
                }

                let x = (star.x / star.z) * cx + cx;
                let y = (star.y / star.z) * cy + cy;

                swCtx.beginPath();
                swCtx.strokeStyle = '#4facfe';
                swCtx.lineWidth = 1.5 * (1 - star.z / swCanvas.width);
                swCtx.moveTo(px, py);
                swCtx.lineTo(x, y);
                swCtx.stroke();
            }
        }

        // --- BOUCLE PRINCIPALE (n'anime que le canvas actif) ---
        function loop() {
            if (!themeCheckbox.checked) {
                drawMatrix();
            } else {
                drawStarWars();
            }
            requestAnimationFrame(loop);
        }
        loop();

        /* ========================================================
           HAMBURGER MENU
           ======================================================== */
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('nav-links');

        hamburger.addEventListener('click', () => {
            const isOpen = navLinks.classList.toggle('open');
            hamburger.classList.toggle('open', isOpen);
            hamburger.setAttribute('aria-expanded', isOpen);
        });

        // Fermer le menu au clic sur un lien
        navLinks.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                navLinks.classList.remove('open');
                hamburger.classList.remove('open');
                hamburger.setAttribute('aria-expanded', false);
            });
        });

        /* ========================================================
           FORMULAIRE DE CONTACT — FEEDBACK UTILISATEUR
           ======================================================== */
        const contactForm = document.getElementById('contact-form');
        const formFeedback = document.getElementById('form-feedback');
        const formSubmit = document.getElementById('form-submit');
        const isStarWars = () => themeCheckbox.checked;

        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const name = document.getElementById('form-name').value.trim();
            const email = document.getElementById('form-email').value.trim();
            const message = document.getElementById('form-message').value.trim();

            if (!name || !email || !message) return;

            // Simulation d'envoi (à remplacer par un vrai backend/EmailJS)
            formSubmit.disabled = true;
            formSubmit.textContent = isStarWars() ? 'TRANSMITTING...' : 'SENDING_PACKET...';

            setTimeout(() => {
                formFeedback.style.display = 'block';
                formFeedback.style.color = isStarWars() ? '#4facfe' : '#00ff66';
                formFeedback.textContent = isStarWars()
                    ? '✓ TRANSMISSION RECEIVED — A Jedi will contact you soon.'
                    : '✓ PACKET_DELIVERED // Connection established. Response incoming.';
                contactForm.reset();
                formSubmit.disabled = false;
                formSubmit.innerHTML = isStarWars()
                    ? '<span class="sw-text">ENGAGE_COMMS</span>'
                    : '<span class="matrix-text">BROADCAST_PACKET</span>';
            }, 1200);
        });

        /* ========================================================
           INTERSECTION OBSERVER — ANIMATIONS AU SCROLL
           ======================================================== */
        document.addEventListener("DOMContentLoaded", () => {
            const animatedElements = document.querySelectorAll(".scroll-animated");

            function updateThemeScrollClasses() {
                animatedElements.forEach(el => {
                    if (themeCheckbox.checked) {
                        el.classList.remove("matrix-scroll");
                        el.classList.add("sw-scroll");
                    } else {
                        el.classList.remove("sw-scroll");
                        el.classList.add("matrix-scroll");
                    }
                });
            }

            updateThemeScrollClasses();
            themeCheckbox.addEventListener("change", updateThemeScrollClasses);

            const observerOptions = {
                root: null,
                threshold: 0.15,
                rootMargin: "0px 0px -50px 0px"
            };

            const scrollObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                    }
                });
            }, observerOptions);

            animatedElements.forEach(el => scrollObserver.observe(el));
        });
    </script>
</body>
</html>
