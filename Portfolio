<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yacine Merghem | Portfolio IA & Automation</title>
    <!-- Typographies Cyber-Futuristes -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=JetBrains+Mono:wght@300;500;700&family=Share+Tech+Mono&family=Cinzel:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Variables par défaut (Thème Matrix) */
            --theme-color: #00ff66;
            --bg-base: #02050a;
            --bg-card: rgba(4, 12, 7, 0.9);
            --text-main: #e2e8f0;
            --text-muted: #748396;
            --border-color: rgba(0, 255, 102, 0.25);
            --shadow-glow: rgba(0, 255, 102, 0.15);
            --font-titles: 'Share Tech Mono', monospace;
            --font-body: 'Share Tech Mono', monospace;
        }

        /* --- LE SWITCH DE THÈME STAR WARS --- */
        #theme-switch {
            display: none;
        }

        #theme-switch:checked ~ * {
            --theme-color: #ffe81f; /* Jaune Star Wars */
            --border-color: rgba(79, 172, 254, 0.4); /* Bleu sabre laser */
            --shadow-glow: rgba(79, 172, 254, 0.3);
            --bg-card: rgba(10, 15, 30, 0.85);
            --font-titles: 'Cinzel', serif;
            --font-body: 'Cinzel', serif;
        }

        /* Visibilité des canevas */
        #matrix-canvas { display: block; }
        #starwars-canvas { display: none; }

        #theme-switch:checked ~ #matrix-canvas { display: none; }
        #theme-switch:checked ~ #starwars-canvas { display: block; }

        /* Contenus textuels adaptatifs */
        .sw-text { display: none; }
        .matrix-text { display: inline; }

        #theme-switch:checked ~ main .matrix-text,
        #theme-switch:checked ~ header .matrix-text { display: none; }
        #theme-switch:checked ~ main .sw-text,
        #theme-switch:checked ~ header .sw-text { display: inline; }

        /* --- STRUCTURAL BASE --- */
        html {
            scroll-behavior: smooth;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-base);
            color: var(--text-main);
            font-family: var(--font-body);
            line-height: 1.6;
            overflow-x: hidden;
            cursor: none;
        }

        .bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            opacity: 0.35;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 25px;
        }

        h1, h2, h3, .logo {
            font-family: var(--font-titles);
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Cinzel (Star Wars) a besoin d'un espacement réduit pour éviter le débordement */
        #theme-switch:checked ~ main h1,
        #theme-switch:checked ~ main h2,
        #theme-switch:checked ~ main h3,
        #theme-switch:checked ~ header .logo,
        #theme-switch:checked ~ header .logo-name {
            letter-spacing: 1px;
        }

        /* ========================================================
           HEADER UNIQUE, ORIGINAL ET ANIMÉ SELON LE THÈME
           ======================================================== */
        header {
            position: fixed;
            top: 0; width: 100%;
            z-index: 1000;
            background: rgba(2, 5, 10, 0.9);
            backdrop-filter: blur(10px);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border-bottom: 2px solid var(--border-color);
        }

        /* Animation Matrix : Barre de chargement système du terminal */
        header::before {
            content: "";
            position: absolute;
            top: 0; left: 0;
            height: 2px;
            background: var(--theme-color);
            box-shadow: 0 0 10px var(--theme-color);
            animation: matrix-loader 3s linear infinite;
        }

        @keyframes matrix-loader {
            0% { width: 0; left: 0; }
            50% { width: 100%; left: 0; }
            100% { width: 0; left: 100%; }
        }

        /* Animation Star Wars : Balayage du radar de visée laser */
        #theme-switch:checked ~ header::after {
            content: "";
            position: absolute;
            bottom: -2px; left: 0;
            width: 100%; height: 2px;
            background: linear-gradient(90deg, transparent, #4facfe, transparent);
            animation: sw-scan 2s ease-in-out infinite;
        }

        @keyframes sw-scan {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 80px;
            position: relative;
        }

        .logo {
            font-weight: 900;
            font-size: 1.6rem;
            color: var(--text-main);
            text-decoration: none;
            text-shadow: 0 0 10px var(--theme-color);
        }
        .logo-svg-wrap {
            display: flex;
            align-items: center;
            gap: 12px;
            text-shadow: none;
        }
        .logo-name {
            font-weight: 900;
            font-size: 1.6rem;
            color: var(--text-main);
            text-shadow: 0 0 10px var(--theme-color);
            font-family: var(--font-titles);
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .logo-dot { color: var(--theme-color); }
        /* SVG logo theming */
        .ym-logo .ym-fill {
            fill: var(--theme-color);
            filter: drop-shadow(0 0 6px var(--theme-color));
            transition: fill 0.4s, filter 0.4s;
        }
        /* Star Wars: gold mountains + blue glow */
        #theme-switch:checked ~ header .ym-logo .ym-fill {
            fill: #ffe81f;
            filter: drop-shadow(0 0 8px #4facfe);
        }
        /* Hover pulse */
        .logo-svg-wrap:hover .ym-logo .ym-fill {
            filter: drop-shadow(0 0 14px var(--theme-color)) drop-shadow(0 0 28px var(--theme-color));
        }
        #theme-switch:checked ~ header .logo-svg-wrap:hover .ym-logo .ym-fill {
            filter: drop-shadow(0 0 14px #4facfe) drop-shadow(0 0 28px #ffe81f);
        }

        .nav-right { display: flex; align-items: center; gap: 30px; }
        .nav-links { display: flex; list-style: none; gap: 25px; }

        .nav-links a {
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.75rem;
            letter-spacing: 1px;
            font-weight: 700;
            position: relative;
            padding: 5px 10px;
            transition: 0.3s;
        }

        /* Effet Hover Matrix (Curseur clignotant de console) */
        .matrix-text-nav:hover::after {
            content: "_";
            animation: blink 0.8s infinite;
            color: var(--theme-color);
        }

        /* Effet Hover Star Wars (Viseurs tactiques de cockpit) */
        .sw-text-nav { display: none; }
        #theme-switch:checked ~ header .matrix-text-nav { display: none; }
        #theme-switch:checked ~ header .sw-text-nav { display: inline-block; }

        .sw-text-nav:hover::before, .sw-text-nav:hover::after {
            content: "";
            position: absolute;
            width: 8px; height: 100%;
            border: 2px solid var(--theme-color);
            animation: bracket-pulse 0.4s infinite alternate;
        }
        .sw-text-nav:hover::before { left: -5px; border-right: 0; top: 0; }
        .sw-text-nav:hover::after { right: -5px; border-left: 0; top: 0; }

        @keyframes bracket-pulse {
            from { transform: scale(1); opacity: 1; }
            to { transform: scale(1.1); opacity: 0.5; }
        }
        @keyframes blink { 50% { opacity: 0; } }

        .theme-btn {
            background: transparent;
            border: 1px solid var(--theme-color);
            color: var(--theme-color);
            padding: 8px 14px;
            font-family: var(--font-titles);
            font-size: 0.65rem;
            cursor: pointer;
            font-weight: 700;
            box-shadow: 0 0 8px var(--shadow-glow);
            transition: 0.3s;
        }

        .theme-btn:hover {
            background: var(--theme-color);
            color: var(--bg-base);
        }

        /* --- SECTIONS --- */
        section { padding: 100px 0; border-bottom: 1px solid rgba(255,255,255,0.05); }

        .section-title {
            font-size: 2rem;
            margin-bottom: 50px;
            text-align: center;
            color: #fff;
            text-shadow: 0 0 10px var(--shadow-glow);
        }

        /* --- HERO --- */
        #hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 120px;
        }

        .badge {
            font-family: var(--font-titles);
            border: 1px solid var(--theme-color);
            color: var(--theme-color);
            padding: 5px 12px;
            font-size: 0.65rem;
            margin-bottom: 20px;
            display: inline-block;
        }

        #hero h1 {
            font-size: 3.8rem;
            line-height: 1.1;
            margin-bottom: 20px;
            background: linear-gradient(to right, #fff, var(--theme-color));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        #hero p {
            color: var(--text-muted);
            max-width: 700px;
            font-size: 1.05rem;
            margin-bottom: 35px;
        }

        .btn {
            font-family: var(--font-titles);
            display: inline-block;
            padding: 12px 28px;
            text-decoration: none;
            background: transparent;
            color: var(--theme-color);
            border: 1px solid var(--theme-color);
            font-weight: 700;
            font-size: 0.75rem;
            transition: 0.4s;
        }

        .btn:hover {
            background: var(--theme-color);
            color: var(--bg-base);
            box-shadow: 0 0 20px var(--theme-color);
        }

        /* --- GRIDS & CARDS --- */
        .grid-3, .grid-2 {
            display: grid;
            gap: 30px;
        }
        .grid-3 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
        .grid-2 { grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 35px;
            transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
            position: relative;
        }

        .card:hover {
            border-color: var(--theme-color);
            transform: translateY(-4px) !important; /* Garde la priorité sur l'animation de scroll au hover */
            box-shadow: 0 10px 30px var(--shadow-glow);
        }

        .card h3 { color: var(--theme-color); font-size: 1.15rem; margin-bottom: 15px; }
        .card h4 { font-family: var(--font-titles); font-size: 0.85rem; color: #fff; margin-bottom: 10px; }
        .card p { font-size: 0.9rem; color: var(--text-muted); }
        .card-meta { font-size: 0.75rem; color: var(--theme-color); margin-bottom: 15px; opacity: 0.8; }

        .tag-container { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px; }
        .tag {
            font-size: 0.65rem;
            border: 1px solid var(--border-color);
            padding: 2px 8px;
            color: var(--theme-color);
            background: rgba(0, 255, 102, 0.03);
        }

        .list-cyber { list-style: none; margin-top: 10px; }
        .list-cyber li { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px; padding-left: 15px; position: relative; }
        .list-cyber li::before { content: ">"; position: absolute; left: 0; color: var(--theme-color); }

        /* ========================================================
           ZONE PROJETS ASYMETRIQUE ET ORIGINAL CONSERVÉE
           ======================================================== */
        .projects-wrapper {
            position: relative;
            width: 100%;
            transition: all 0.5s ease-in-out;
        }

        /* --- MODE 1 : MATRIX (Pipeline Vertical Alterné + Glitch) --- */
        .matrix-pipeline {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .matrix-pipeline .project-card {
            background: rgba(2, 8, 4, 0.9);
            border-left: 4px solid var(--theme-color);
            border-top: 1px solid var(--border-color);
            border-right: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 25px 30px;
            transition: 0.2s;
            cursor: pointer;
        }

        @keyframes matrix-glitch {
            0% { transform: translate(0); text-shadow: none; }
            20% { transform: translate(-2px, 2px); text-shadow: 1px 0 #00ff66, -1px 0 #ff0000; }
            40% { transform: translate(-2px, -2px); text-shadow: -1px 0 #00ff66, 1px 0 #00f2fe; }
            60% { transform: translate(2px, 2px); text-shadow: 1px -1px #00ff66, 2px 0 #ff00ff; }
            80% { transform: translate(2px, -2px); text-shadow: none; }
            100% { transform: translate(0); }
        }

        .matrix-pipeline .project-card:hover {
            animation: matrix-glitch 0.3s linear infinite;
            background: rgba(0, 255, 102, 0.05);
            border-left-color: #fff;
            box-shadow: 0 0 15px rgba(0, 255, 102, 0.2);
        }

        .matrix-pipeline .project-card h3::before {
            content: "[LOG_FILE] ";
            font-size: 0.8rem;
            opacity: 0.7;
        }

        /* --- MODE 2 : STAR WARS (Cockpit Arc de Cercle + Lévitation) --- */
        .sw-galaxy-view {
            display: none;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            perspective: 1000px;
            padding-top: 40px;
        }

        .sw-galaxy-view .project-card:nth-child(1) { transform: rotateY(15deg) translateY(-10px); }
        .sw-galaxy-view .project-card:nth-child(2) { transform: translateZ(20px) translateY(10px); }
        .sw-galaxy-view .project-card:nth-child(3) { transform: rotateY(-15deg) translateY(-10px); }

        .sw-galaxy-view .project-card {
            background: rgba(9, 18, 34, 0.85);
            border: 1px solid var(--border-color);
            border-bottom: 3px solid var(--border-color);
            padding: 35px 25px;
            text-align: center;
            box-shadow: 0 0 20px rgba(79, 172, 254, 0.1);
            animation: sw-float 4s ease-in-out infinite alternate;
        }

        .sw-galaxy-view .project-card:nth-child(2) { animation-delay: 1.3s; }
        .sw-galaxy-view .project-card:nth-child(3) { animation-delay: 2.6s; }

        @keyframes sw-float {
            0% { transform: translateY(0px) rotateY(var(--rot, 0deg)); box-shadow: 0 5px 15px var(--shadow-glow); }
            100% { transform: translateY(-15px) rotateY(var(--rot, 0deg)); box-shadow: 0 20px 35px var(--shadow-glow); }
        }

        .sw-galaxy-view .project-card:nth-child(1) { --rot: 15deg; }
        .sw-galaxy-view .project-card:nth-child(2) { --rot: 0deg; }
        .sw-galaxy-view .project-card:nth-child(3) { --rot: -15deg; }

        .sw-galaxy-view .project-card:hover {
            border-color: #fff !important;
            background: rgba(79, 172, 254, 0.15);
            cursor: crosshair;
        }

        /* Switch Structures Projets */
        #theme-switch:checked ~ main .matrix-pipeline { display: none; }
        #theme-switch:checked ~ main .sw-galaxy-view { display: grid; }

        /* --- CONTACT --- */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .info-panel p { margin-bottom: 15px; font-size: 0.95rem; }
        .info-panel strong { color: var(--theme-color); font-family: var(--font-titles); font-size: 0.8rem; }

        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; font-family: var(--font-titles); font-size: 0.65rem; margin-bottom: 8px; color: var(--theme-color); }
        .form-group input, .form-group textarea {
            width: 100%; padding: 12px; background: rgba(0,0,0,0.5); border: 1px solid var(--border-color); color: #fff; font-family: var(--font-body); font-size: 0.85rem;
        }
        .form-group input:focus, .form-group textarea:focus { outline: none; border-color: var(--theme-color); }

        footer { text-align: center; padding: 40px; font-family: var(--font-titles); font-size: 0.6rem; color: var(--text-muted); letter-spacing: 2px; }

        /* ========================================================
           CURSEURS PERSONNALISÉS
           ======================================================== */

        /* Curseur Matrix : croix de terminal avec halo vert */
        #cursor-matrix {
            position: fixed;
            top: 0; left: 0;
            pointer-events: none;
            z-index: 99999;
            display: block;
        }
        #cursor-matrix .cursor-cross {
            position: absolute;
            transform: translate(-50%, -50%);
            width: 22px;
            height: 22px;
        }
        #cursor-matrix .cursor-cross::before,
        #cursor-matrix .cursor-cross::after {
            content: '';
            position: absolute;
            background: #00ff66;
            box-shadow: 0 0 6px #00ff66, 0 0 12px #00ff66;
        }
        #cursor-matrix .cursor-cross::before {
            width: 2px; height: 100%;
            left: 50%; top: 0;
            transform: translateX(-50%);
        }
        #cursor-matrix .cursor-cross::after {
            height: 2px; width: 100%;
            top: 50%; left: 0;
            transform: translateY(-50%);
        }
        /* Point central */
        #cursor-matrix .cursor-dot {
            position: absolute;
            transform: translate(-50%, -50%);
            width: 4px; height: 4px;
            background: #fff;
            box-shadow: 0 0 4px #00ff66;
        }
        /* Anneau de trail */
        #cursor-matrix .cursor-ring {
            position: absolute;
            transform: translate(-50%, -50%);
            width: 36px; height: 36px;
            border: 1px solid rgba(0,255,102,0.4);
            border-radius: 50%;
            transition: width 0.12s, height 0.12s, opacity 0.12s;
        }
        body.cursor-hovering #cursor-matrix .cursor-ring {
            width: 52px; height: 52px;
            border-color: rgba(0,255,102,0.8);
        }
        /* Texte clignotant sous le curseur Matrix */
        #cursor-matrix .cursor-text {
            position: absolute;
            top: 14px; left: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 9px;
            color: #00ff66;
            white-space: nowrap;
            opacity: 0.8;
            animation: blink 1s infinite;
            letter-spacing: 1px;
        }

        /* Curseur Star Wars : viseur de cockpit / réticule laser */
        #cursor-starwars {
            position: fixed;
            top: 0; left: 0;
            pointer-events: none;
            z-index: 99999;
            display: none;
        }
        #cursor-starwars .sw-reticle {
            position: absolute;
            transform: translate(-50%, -50%);
            width: 32px; height: 32px;
            animation: sw-reticle-spin 4s linear infinite;
        }
        #cursor-starwars .sw-reticle svg {
            width: 100%; height: 100%;
        }
        /* Anneau extérieur qui pulse */
        #cursor-starwars .sw-outer {
            position: absolute;
            transform: translate(-50%, -50%);
            width: 50px; height: 50px;
            border: 1px solid rgba(79,172,254,0.3);
            border-radius: 50%;
            animation: sw-pulse-ring 2s ease-in-out infinite;
        }
        body.cursor-hovering #cursor-starwars .sw-outer {
            width: 64px; height: 64px;
            border-color: rgba(255,232,31,0.7);
        }
        /* Trail sabre laser */
        #cursor-starwars .sw-saber-trail {
            position: absolute;
            top: 0; left: 0;
            pointer-events: none;
        }
        @keyframes sw-reticle-spin {
            from { transform: translate(-50%,-50%) rotate(0deg); }
            to   { transform: translate(-50%,-50%) rotate(360deg); }
        }
        @keyframes sw-pulse-ring {
            0%, 100% { opacity: 0.3; transform: translate(-50%,-50%) scale(1); }
            50%       { opacity: 0.8; transform: translate(-50%,-50%) scale(1.15); }
        }

        /* Gestion affichage selon thème */
        body.theme-sw #cursor-matrix   { display: none; }
        body.theme-sw #cursor-starwars { display: block; }
        body.theme-sw * { cursor: none !important; }
        body:not(.theme-sw) * { cursor: none !important; }

        /* ========================================================
           OVERLAY DE TRANSITION THÉMATIQUE
           ======================================================== */
        #transition-overlay {
            position: fixed;
            inset: 0;
            z-index: 9999;
            pointer-events: none;
            display: none;
        }
        #transition-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }
        #transition-flash {
            position: absolute;
            inset: 0;
            opacity: 0;
        }

        /* ========================================================
           NOUVEAU : STYLES POUR ANIMATIONS DE SCROLL PAR THÈME
           ======================================================== */
        
        /* État initial commun avant le scroll */
        .scroll-animated {
            opacity: 0;
            transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            will-change: transform, opacity;
        }

        /* --- THÈME 1 : ANIMATION MATRIX (Apparition Terminal / Scan vertical) --- */
        .scroll-animated.matrix-scroll {
            transform: translateY(30px) scale(0.98);
            filter: brightness(0.3) blur(2px);
        }

        /* Quand visible sous Matrix */
        .scroll-animated.matrix-scroll.is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: brightness(1) blur(0);
        }

        /* --- THÈME 2 : ANIMATION STAR WARS (Hypervitesse / Translation latérale Force) --- */
        #theme-switch:checked ~ main .scroll-animated.sw-scroll {
            transform: translateX(-50px) translateZ(-100px);
            filter: blur(5px);
        }

        /* Quand visible sous Star Wars */
        #theme-switch:checked ~ main .scroll-animated.sw-scroll.is-visible {
            opacity: 1;
            transform: translateX(0) translateZ(0);
            filter: blur(0);
        }

        /* --- HAMBURGER MENU --- */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 5px;
            background: transparent;
            border: none;
        }
        .hamburger span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--theme-color);
            transition: 0.3s;
            box-shadow: 0 0 5px var(--theme-color);
        }
        .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .hamburger.open span:nth-child(2) { opacity: 0; }
        .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        @media (max-width: 900px) {
            .sw-galaxy-view { grid-template-columns: 1fr; }
            .sw-galaxy-view .project-card:nth-child(1),
            .sw-galaxy-view .project-card:nth-child(2),
            .sw-galaxy-view .project-card:nth-child(3) { transform: none !important; animation: none; }
            #hero h1 { font-size: 2.5rem; }
            .contact-grid { grid-template-columns: 1fr; gap: 30px; }
            .hamburger { display: flex; }
            .nav-links {
                display: none;
                position: absolute;
                top: 80px;
                right: 0;
                background: rgba(2, 5, 10, 0.97);
                border: 1px solid var(--border-color);
                flex-direction: column;
                gap: 0;
                min-width: 200px;
                z-index: 999;
            }
            .nav-links.open { display: flex; }
            .nav-links li { border-bottom: 1px solid var(--border-color); }
            .nav-links a { display: block; padding: 14px 20px; font-size: 0.8rem; }
        }
    </style>
